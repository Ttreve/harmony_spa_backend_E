# Copia este archivo a .env y ajusta los valores (el archivo .env NO se sube a Git).

# --- Aplicación ---
APP_NAME=Harmony Spa API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Base de datos ---
# Reemplaza usuario, contraseña y host por los de tu instalación local de MySQL.
DATABASE_URL=mysql+pymysql://harmony_user:CAMBIAR_PASSWORD@localhost:3306/harmony_spa?charset=utf8mb4

# --- Autenticación ---
# Clave con la que se firman los JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# La app NO arranca si queda este valor de ejemplo o tiene menos de 32 caracteres.
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_SECRETA_DE_AL_MENOS_32_CARACTERES
JWT_ALGORITHM=HS256
# Vida máxima de una sesión: 2 horas (120 min), aunque el usuario siga activo.
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Si pasan 30 min sin usar la API, la sesión se cierra.
INACTIVITY_TIMEOUT_MINUTES=30

# --- CORS ---
# Orígenes del frontend permitidos, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
